    "slug": "nextgen-mobiles",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.nextgenmobiles.shop",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#FFF8F5"
      }
    },
    "ios": {
      "bundleIdentifier": "com.nextgenmobiles.shop"
    },
    "plugins": [
      [
        "expo-status-bar",
        {
          "hidden": false,
          "style": "light"
        }
      ]
    ],
    "androidStatusBar": {
