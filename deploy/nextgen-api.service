[Unit]
Description=NextGen Mobiles PostgreSQL API and admin panel
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=nextgen
Group=nextgen
WorkingDirectory=/opt/nextgen-mobile-shop/backend
EnvironmentFile=/etc/nextgen-mobile-shop/backend.env
ExecStart=/usr/bin/node /opt/nextgen-mobile-shop/backend/server.js
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nextgen-mobiles
UMask=0027

[Install]
WantedBy=multi-user.target
