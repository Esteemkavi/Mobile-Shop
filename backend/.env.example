# Existing PostgreSQL database; this app only creates objects in schema nextgen_app.
DATABASE_URL=postgresql://nextgen_app:CHANGE_ME@127.0.0.1:5432/nextgen_mobiles
HOST=127.0.0.1
PORT=3001
NODE_ENV=production
COOKIE_SECURE=false
DATA_DIR=/var/lib/nextgen-mobiles

# Create an scrypt hash with: npm run admin:hash
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Add the Expo web development origin only when needed, e.g. http://192.168.1.10:8082
CORS_ORIGINS=
TRUST_PROXY=false
